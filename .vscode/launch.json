{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (nodemon + debug)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "📦 Build Frontend",
      "runtimeExecutable": "${workspaceFolder}/server/node_modules/.bin/nodemon",
      "program": "${workspaceFolder}/server/src/index.js",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Frontend (Vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/client",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Start All (Backend + Frontend)",
      "configurations": ["Backend (nodemon + debug)", "Frontend (Vite)"],
      "stopAll": true
    }
  ]
}
