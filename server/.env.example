# ==============================
# LINE 智能客服系統 - 環境變數
# ==============================
# 複製此檔案為 .env 並填入真實值
# cp .env.example .env

# 後端服務埠（預設 3000）
PORT=3000

# PostgreSQL 連線字串（必填）
DATABASE_URL=postgresql://user:pass@localhost:5432/line_cs

# !! JWT 簽名金鑰（必填）!!
# !! 必須替換！使用預設值會導致系統拒絕啟動 !!
# !! 用途：簽署管理員登入 Token，洩漏則他人可偽造身份 !!
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=your-jwt-secret-key-change-in-production

# !! AES-256-GCM 加密金鑰（必填，64 個 hex 字元）!!
# !! 未設定則系統拒絕啟動 !!
# !! 用途：加密 DB 中的 API Key、LINE Token 等敏感資料 !!
# !! 請務必備份！遺失後已加密的設定將無法解密 !!
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS 允許的子網域模式（逗號分隔，支援 * 萬用字元）
# 預設允許 *.openclaw-gb.com
# CORS_ALLOWED_ORIGINS=*.openclaw-gb.com,*.example.com

# === 以下為 Fallback 值，優先從管理後台 Settings 頁面設定 ===

# LINE Channel Secret（Fallback，優先從 DB 讀取）
LINE_CHANNEL_SECRET=your-line-channel-secret

# LINE Channel Access Token（Fallback，優先從 DB 讀取）
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# Google Gemini API Key（Fallback，優先從 DB 讀取）
GOOGLE_AI_API_KEY=your-google-ai-api-key
